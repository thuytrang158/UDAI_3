# Copy to .env and enter your own Groq keys. Never commit real API keys.
# Groq Cloud model (API keys may be supplied as GROQ_API_KEY or GROQ_API_KEY_1..6)
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
GROQ_API_KEY_5=
GROQ_API_KEY_6=
GROQ_MODEL=qwen/qwen3.8-27b
PLANNER_GROQ_MODEL=qwen/qwen3.8-27b

# Local Ollama fallback (used when no Groq key is configured)
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Planner discovery and geocoding
MYTHAINGUYEN_MAX_PAGES=5
MYTHAINGUYEN_MAX_DETAILS=18
PLACE_SOURCE_TIMEOUT_SECONDS=8
THAI_NGUYEN_SOURCE_BUDGET_SECONDS=35
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Multi-Agent-AI-Travel-Planner/1.0

# RAG embedding model
BGE_M3_MODEL=BAAI/bge-m3
