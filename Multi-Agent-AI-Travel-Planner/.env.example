# AI provider. Configure Groq or leave its key empty to use local Ollama.
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
PLANNER_GROQ_MODEL=qwen/qwen3.8-27b

# Ollama fallback, used when no Groq key is configured
OLLAMA_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://localhost:11434

# Place discovery and geocoding
MYTHAINGUYEN_MAX_PAGES=5
MYTHAINGUYEN_MAX_DETAILS=18
PLACE_SOURCE_TIMEOUT_SECONDS=8
THAI_NGUYEN_SOURCE_BUDGET_SECONDS=35
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=Multi-Agent-AI-Travel-Planner/1.0

# Optional local retrieval-augmented chatbot model
BGE_M3_MODEL=BAAI/bge-m3
